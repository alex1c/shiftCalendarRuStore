{
  "expo": {
    "name": "Мой график смен",
    "slug": "shift-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_gpt.png",
    "scheme": "shiftcalendar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calculatorplatform.shiftcalendar"
    },
    "android": {
      "package": "com.calculatorplatform.shiftcalendar",
      "versionCode": 1,
      "icon": "./assets/icon_gpt.png",
      "adaptiveIcon": {
        "backgroundColor": "#1D98FE",
        "foregroundImage": "./assets/icon-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon_gpt.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA"
        }
      ],
      "expo-sharing",
      "./plugins/withAppMetricaAutolinking"
    ],
    "extra": {
      "appMetricaApiKey": "e0b1b59c-bed2-4f4f-a8e3-b14603f56a32",
      "appMetricaApplicationId": "6355141",
      "developerName": "ForestMusic",
      "developerSite": "https://forest-music.ru",
      "developerContact": "rustore-alex1c@yandex.ru",
      "privacyPolicyUrl": "https://alex1c.github.io/shiftCalendarRuStore/privacy.html"
    }
  }
}
